{
  "realm": "compat",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "igrp-access-management",
      "name": "iGRP Access Management (compat suite)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "compat-keycloak-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "https://app.example.cv/*##+"
      }
    },
    {
      "clientId": "igrp-am-adapter",
      "name": "AM's adapter account: manages federated service clients (v3-17)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "compat-adapter-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-igrp-am-adapter",
      "enabled": true,
      "serviceAccountClientId": "igrp-am-adapter",
      "clientRoles": {
        "realm-management": ["manage-clients", "view-clients", "query-clients"]
      }
    },
    {
      "username": "fulano",
      "enabled": true,
      "email": "fulano@example.cv",
      "emailVerified": true,
      "firstName": "Fulano",
      "lastName": "de Tal",
      "credentials": [
        {
          "type": "password",
          "value": "compat-password",
          "temporary": false
        }
      ]
    }
  ]
}
