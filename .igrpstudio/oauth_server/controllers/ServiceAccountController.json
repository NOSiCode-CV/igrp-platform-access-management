{
  "type": "controller",
  "name": "ServiceAccount",
  "module": "oauth_server",
  "description": "Manage OAuth client service accounts",
  "basePath": "api",
  "actions": [
    {
      "actionName": "findAllServiceAccounts",
      "path": "service-accounts",
      "method": "GET",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "ServiceAccountDTO",
                "name": "data",
                "collectionType": "list",
                "objectType": "dto",
                "module": "oauth_server"
              }
            }
          }
        }
      },
      "permission": {
        "items": [
          "igrp.client.list"
        ],
        "operator": "OR"
      }
    },
    {
      "actionName": "findServiceAccountById",
      "path": "service-accounts/{id}",
      "method": "GET",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "ServiceAccountDTO",
                "name": "data",
                "collectionType": "none",
                "objectType": "dto",
                "module": "oauth_server"
              }
            }
          }
        }
      },
      "pathVariables": [
        {"name": "id", "type": "uuid", "isRequired": true}
      ],
      "permission": {
        "items": [
          "igrp.client.view"
        ],
        "operator": "OR"
      }
    },
    {
      "actionName": "createServiceAccount",
      "path": "service-accounts",
      "method": "POST",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "ServiceAccountRequestDTO",
              "name": "data",
              "objectType": "dto",
              "module": "oauth_server",
              "collectionType": "none"
            }
          }
        }
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "type": "ServiceAccountDTO",
                "name": "data",
                "collectionType": "none",
                "objectType": "dto",
                "module": "oauth_server"
              }
            }
          }
        }
      },
      "permission": {
        "items": [
          "igrp.client.create"
        ],
        "operator": "OR"
      }
    },
    {
      "actionName": "updateServiceAccount",
      "path": "service-accounts/{id}",
      "method": "PUT",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "ServiceAccountRequestDTO",
              "name": "data",
              "objectType": "dto",
              "module": "oauth_server",
              "collectionType": "none"
            }
          }
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "ServiceAccountDTO",
                "name": "data",
                "collectionType": "none",
                "objectType": "dto",
                "module": "oauth_server"
              }
            }
          }
        }
      },
      "pathVariables": [
        {"name": "id", "type": "uuid", "isRequired": true}
      ],
      "permission": {
        "items": [
          "igrp.client.update"
        ],
        "operator": "OR"
      }
    },
    {
      "actionName": "deleteServiceAccount",
      "path": "service-accounts/{id}",
      "method": "DELETE",
      "responses": {
        "204": {
          "content": {}
        }
      },
      "pathVariables": [
        {"name": "id", "type": "uuid", "isRequired": true}
      ],
      "permission": {
        "items": [
          "igrp.client.delete"
        ],
        "operator": "OR"
      }
    }
  ],
  "id": "oauth-server-controller-service-accounts"
}
