{
  "type": "dto",
  "module": "oauth_server",
  "name": "ServiceAccountDTO",
  "template": "classic",
  "attributes": [
    {"name": "id", "type": "uuid"},
    {"name": "name", "type": "string", "required": true},
    {"name": "description", "type": "string"},
    {"name": "active", "type": "boolean"},
    {"name": "oauthClientId", "type": "uuid", "required": true},
    {"name": "clientId", "type": "string"},
    {"name": "applicationId", "type": "integer"},
    {"name": "applicationCode", "type": "string"},
    {"name": "roleIds", "type": "integer", "collectionType": "set"},
    {"name": "roleCodes", "type": "string", "collectionType": "set"},
    {"name": "permissionIds", "type": "integer", "collectionType": "set"},
    {"name": "permissionNames", "type": "string", "collectionType": "set"},
    {"name": "createdAt", "type": "datetime"},
    {"name": "updatedAt", "type": "datetime"}
  ],
  "id": "oauth-server-dto-service-account"
}
