    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${javadoc.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>26</source>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>

                        <!-- IGRP Framework Core (annotation processor) -->
                        <path>
                            <groupId>cv.igrp.framework</groupId>
                            <artifactId>core</artifactId>
                            <version>${igrp.version}</version>
                        </path>

                        <!-- IGRP Stereotype Processor -->
                        <path>
                            <groupId>cv.igrp.framework</groupId>
                            <artifactId>stereotype</artifactId>
                            <version>${igrp.framework.stereotype.version}</version>
                        </path>

                        <!-- IGRP Framework Auth Processor (this is the one you need for authorities
                        mapping!) -->
                        <path>
                            <groupId>cv.igrp.framework.auth</groupId>
                            <artifactId>core</artifactId>
                            <version>${framework.auth.version}</version>
                        </path>

                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.76</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <!-- Boilerplate / value objects -->
                        <exclude>**/*DTO.class</exclude>
                        <exclude>**/*Command.class</exclude>
                        <exclude>**/*Query.class</exclude>
                        <exclude>**/*Event.class</exclude>
                        <!-- REST layer (integration-tested) -->
                        <exclude>**/interfaces/rest/**</exclude>
                        <exclude>**/controller/**</exclude>
                        <!-- Persistence (JPA entities + Spring Data repos) -->
                        <exclude>**/infrastructure/persistence/entity/**</exclude>
                        <exclude>**/infrastructure/persistence/repository/**</exclude>
                        <exclude>**/specs/**</exclude>
                        <exclude>**/mapper/**</exclude>
                        <!-- Spring config / bootstrap -->
                        <exclude>**/config/**</exclude>
                        <exclude>**/spring/**</exclude>
                        <exclude>**/IgrpPlatformAccessManagementApplication.class</exclude>
                        <exclude>**/infrastructure/bootstrap/**</exclude>
                        <exclude>**/infrastructure/scheduler/**</exclude>
                        <exclude>**/infrastructure/metrics/**</exclude>
                        <exclude>**/infrastructure/cache/**</exclude>
                        <!-- Security infrastructure (Spring Security filters/config) -->
                        <exclude>**/shared/security/**</exclude>
                        <exclude>**/oauth_server/**</exclude>
                        <!-- Bounded contexts integration-tested only -->
                        <exclude>**/session/**</exclude>
                        <exclude>**/security_audit/**</exclude>
                        <exclude>**/notification/domain/**</exclude>
                        <!-- Cross-cutting: exception handlers, constants/enums, audit POJOs -->
                        <exclude>**/shared/domain/exceptions/**</exclude>
                        <exclude>**/shared/domain/audit/**</exclude>
                        <exclude>**/shared/domain/converters/**</exclude>
                        <exclude>**/shared/domain/validation/**</exclude>
                        <exclude>**/shared/application/constants/**</exclude>
                        <exclude>**/shared/api/audit/**</exclude>
                        <exclude>**/shared/infrastructure/authorization/**</exclude>
                        <!-- Framework-generated code -->
                        <exclude>cv/igrp/framework/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnError>false</failOnError>
                    <additionalJOption>-Xdoclint:none</additionalJOption>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDirectory>${project.build.directory}/reports</outputDirectory>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFile>${project.basedir}/dependency-check-suppression.xml</suppressionFile>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.hibernate.orm.tooling</groupId>
                <artifactId>hibernate-enhance-maven-plugin</artifactId>
                <version>6.6.18.Final</version>
                <!--
                  Override the Byte Buddy version pulled in transitively by
                  hibernate-enhance (1.15.x). The shipped version does not
                  recognize the Java 25 class file format and aborts with
                  "Java 25 (69) is not supported by the current version of
                  Byte Buddy". 1.17.7+ adds official Java 25 support.
                -->
                <dependencies>
                    <dependency>
                        <groupId>net.bytebuddy</groupId>
                        <artifactId>byte-buddy</artifactId>
                        <version>1.17.7</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <configuration>
                            <enableLazyInitialization>true</enableLazyInitialization>
                            <enableDirtyTracking>true</enableDirtyTracking>
                            <enableAssociationManagement>true</enableAssociationManagement>
                        </configuration>
                        <goals>
                            <goal>enhance</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.11.1</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${project.artifactId}</imageName>
                            <buildArgs>
                                <buildArg>${native.march}</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>--static-nolibc</buildArg>
                                <buildArg>-H:-CheckToolchain</buildArg>
                                <buildArg>-H:+ReportUnsupportedElementsAtRuntime</buildArg>
                                <buildArg>-H:IncludeResources=menus\.json</buildArg>
                                <buildArg>-H:IncludeResources=application-.*\.properties</buildArg>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>
                                    -H:ResourceConfigurationFiles=!META-INF/native-image/software.amazon.awssdk/**
                                </buildArg>
                                <buildArg>--enable-url-protocols=http,https</buildArg>
                                <buildArg>-O1</buildArg>
                                <buildArg>--gc=serial</buildArg>
                                <buildArg>-J-Xmx10g</buildArg>
                                <buildArg>-J-Xms2g</buildArg>
                                <buildArg>-R:MaxHeapSize=2G</buildArg>
                                <buildArg>-H:NumberOfThreads=4</buildArg>
                                <buildArg>--initialize-at-build-time=org.slf4j</buildArg>
                                <buildArg>--initialize-at-build-time=org.slf4j.helpers</buildArg>
                                <buildArg>--initialize-at-build-time=ch.qos.logback</buildArg>
                                <buildArg>
                                    --initialize-at-build-time=io.micrometer.core.instrument.binder.logging
                                </buildArg>
                                <buildArg>--verbose</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>apple-silicon</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.march>-march=native</native.march>
            </properties>
        </profile>

        <profile>
            <id>target-arm64</id>
            <activation>
                <property>
                    <name>build.target</name>
                    <value>arm64</value>
                </property>
            </activation>
            <properties>
                <native.march>-march=armv8-a</native.march>
            </properties>
        </profile>

        <profile>
            <id>target-amd64</id>
            <activation>
                <property>
                    <name>build.target</name>
                    <value>amd64</value>
                </property>
            </activation>
            <properties>
                <native.march>-march=x86-64</native.march>
            </properties>
        </profile>

        <profile>
            <id>native-default</id>
            <activation>
                <property>
                    <name>!build.target</name>
                </property>
            </activation>
            <properties>
                <native.march>-march=native</native.march>
            </properties>
        </profile>

        <profile>
            <id>basic-auth</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
