    <version>0.0.1-SNAPSHOT</version>
    <name>igrp_platform_access_management</name>
    <description>IGRP Platform Access Management</description>

    <properties>
        <igrp.version>0.1.0-beta.1</igrp.version>
        <java.version>26</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <springdoc.version>2.8.17</springdoc.version>
        <otel.version>2.28.1</otel.version>
        <jacoco.version>0.8.13</jacoco.version>
        <dependency-check.version>12.1.6</dependency-check.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <igrp.framework.core.version>0.0.3-alpha</igrp.framework.core.version>
        <igrp.framework.stereotype.version>0.1.0-beta-20251021.121417-2</igrp.framework.stereotype.version>
        <framework.auth.version>0.1.0-beta.1</framework.auth.version>
        <!-- All three file-manager artifacts are released in lockstep and
             minio depends on the core, so they share one property. 0.2.0-beta.1
             carries minio 8.6.0, which fixes CVE-2026-45925. The StorageService
             interface is byte-identical to 0.1.0-beta.2's, which is the only
             surface this service uses. -->
        <filemanager.version>0.2.0-beta.1</filemanager.version>
        <igrp.framework.notification.core.version>0.0.1-alpha</igrp.framework.notification.core.version>
        <igrp.platform.notification.client.version>0.2.0-beta.5</igrp.platform.notification.client.version>

        <!--
            Security patch overrides on top of the parent BOM (2026-10-28).
            Each raises a version the parent still pins below its patched
            release; all stay inside the current minor line, so no API change
            is implied. Replaces the per-artifact <dependencyManagement> pins
            that used to live below, because these are the same properties
            spring-boot-dependencies uses and so they cover every sibling
            artifact in each family rather than only the ones enumerated.

            Drop an entry once the parent BOM catches up to or passes it.
        -->
        <!-- 3 CRITICAL. Must stay on 10.1.x: Tomcat 11 is Servlet 6.1 and
             Boot 3.5 targets 6.0. The advisories name 10.1.58 as the fix, but
             that version was never published — the line goes 10.1.57 -> 10.1.59. -->
        <tomcat.version>10.1.61</tomcat.version>
        <!-- 1 CRITICAL, 8 HIGH. Deliberately the 4.2 line, not the 4.1 the
             parent manages; this predates the current report. -->
        <netty.version>4.2.19.Final</netty.version>
        <!-- 8 HIGH. The parent reaches only 2.21.4, which is short of the fix. -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <!-- 1 HIGH -->
        <postgresql.version>42.7.12</postgresql.version>
        <!-- 1 MEDIUM -->
        <log4j2.version>2.26.1</log4j2.version>
        <!-- 2 CRITICAL, 1 HIGH, 2 MEDIUM. Not managed by the parent BOM at
             all, so it needs dependencyManagement entries below. bcprov
             arrives transitively via spring-cloud-commons; BouncyCastle
             expects its modules version-aligned, so both are set together. -->
        <bouncycastle.version>1.85</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${otel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Netty, Tomcat, Jackson, PostgreSQL and Log4j2 are now raised
                 through the parent's own version properties (see <properties>)
                 rather than pinned per artifact here. -->
            <!-- BouncyCastle is NOT in the parent BOM, so it does need entries.
                 bcprov is transitive (spring-cloud-commons) and was previously
                 unpinned at 1.80 while bcpkix was pinned at 1.82 — a split the
                 library does not support. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- Override transitive deps with CVEs the parent BOM doesn't catch -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>4.5.14</version>
            </dependency>
            <dependency>
                <groupId>org.bitbucket.b_c</groupId>
                <artifactId>jose4j</artifactId>
                <version>0.9.6</version>
            </dependency>
            <dependency>
                <groupId>commons-jxpath</groupId>
                <artifactId>commons-jxpath</artifactId>
                <version>1.4.0</version>
            </dependency>
            <!-- Align commons-compress with what POI asks for, rather than
                 whatever wins nearest-first.
                 POI 5.4.1 declares 1.27.1, but io.kubernetes:client-java
                 declares 1.26.1 closer to the root, so Maven silently
                 DOWNGRADES it under POI. POI uses commons-compress for the
                 OOXML zip container, so a call added after 1.26.1 would fail
                 with NoSuchMethodError inside the audit-report export —
                 at runtime, in a download, not at build time.
                 The mismatch predates the POI 5.3.0 -> 5.4.1 bump (5.3.0
                 wanted 1.26.2) but was only patch-level then; the bump widened
                 it to a minor, which is what made it worth pinning. Not
                 security-driven: no advisory against 1.26.1 in the scan. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.27.1</version>
            </dependency>
            <!-- 2 HIGH + 1 MEDIUM, all DoS/crash on malformed or oversized
                 compressed input: CVE-2026-108106, CVE-2026-93451,
                 CVE-2026-116590. Transitive via io.minio:minio; a patch bump
                 inside 1.1.10.x, and not managed by the parent BOM, so it
                 needs an entry here. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>
            <!-- CVE-2026-102554 (HIGH): DoS via unthrottled allocation while
                 deserializing. Required at RUNTIME by io.minio:minio, so this
                 one cannot be excluded the way auto-service's copy was.
                 The scan reported 32.0.1-jre because that copy was winning
                 nearest-first; with it gone, minio's 33.4.8-jre surfaces, so
                 this is a bump inside 33.x rather than the 32 -> 33 jump the
                 advisory implies. Use the -jre flavour, not -android. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- R3.2 — shared servlet session across replicas, stored in Postgres.
             Version managed by spring-boot-starter-parent (spring-session BOM).
             Postgres rather than Redis: it is already a hard dependency of login,
             so the session store adds no new failure mode. See
             plans/shared-servlet-session/scope.md Section 1. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.netflix.eureka</groupId>
            <artifactId>eureka-client</artifactId>
            <version>2.0.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>
        <!-- POI 5.3.0 requires commons-io >= 2.16 (BoundedInputStream.builder());
             pin it so an older transitive 2.14.0 does not win. -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-envers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-kubernetes-client</artifactId>
        </dependency>
        <!-- https://mvnrepository.com/artifact/io.kubernetes/client-java -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <version>19.0.3</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.bouncycastle/bcpkix-jdk18on -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.google.protobuf/protobuf-java -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.9</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cv.igrp.framework</groupId>
            <artifactId>core</artifactId>
            <version>${igrp.version}</version>
        </dependency>
        <dependency>
            <groupId>cv.igrp.framework</groupId>
            <artifactId>stereotype</artifactId>
            <version>${igrp.framework.stereotype.version}</version>
        </dependency>
        <dependency>
            <groupId>cv.igrp.framework.auth</groupId>
            <artifactId>core</artifactId>
            <version>${framework.auth.version}</version>
            <exclusions>
                <!-- auto-service is an ANNOTATION PROCESSOR and is declared at
                     compile scope by this library, so it and its dependency
                     chain land on the runtime classpath:

                       auto-service -> auto-common -> guava 32.0.1-jre

                     This is NOT the only guava in the graph — io.minio:minio
                     needs one at runtime — but 32.0.1 was winning nearest-first
                     and masking minio's much newer 33.4.8. Removing this chain
                     lets the real one through, and annotation processors have no
                     business in a production jar regardless. (dependency:tree
                     prints only the winning version, so the second source was
                     invisible until this exclusion landed.)

                     Safe because the <annotationProcessorPaths> below already
                     declares cv.igrp.framework.auth:core explicitly, and
                     processor paths resolve their own dependencies
                     independently of the compile classpath — so code
                     generation still gets auto-service, the shipped jar does
                     not.

                     The real fix belongs upstream: that library should mark
                     auto-service (and javapoet) as provided. Drop this
                     exclusion once it does. -->
                <exclusion>
                    <groupId>com.google.auto.service</groupId>
                    <artifactId>auto-service</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cv.igrp.platform</groupId>
            <artifactId>filemanager</artifactId>
            <version>${filemanager.version}</version>
        </dependency>
        <dependency>
            <groupId>cv.igrp.framework.filemanager</groupId>
            <artifactId>aws-s3</artifactId>
            <version>${filemanager.version}</version>
        </dependency>
        <dependency>
            <groupId>cv.igrp.framework.filemanager</groupId>
            <artifactId>minio</artifactId>
            <version>${filemanager.version}</version>
        </dependency>
        <dependency>
            <groupId>cv.igrp.framework</groupId>
            <artifactId>notifications-core</artifactId>
            <version>${igrp.framework.notification.core.version}</version>
        </dependency>
        <!--
          Notification Service Java client — primary delivery path for the
          user-invitation email (template "user-invitation" seeded under
          APP_IGRP_CENTER). The legacy Spring Mail sender above remains the
          fallback when igrp.notification.service.enabled=false or the service
          is unreachable at send time; see InvitationNotificationSender.
        -->
        <dependency>
            <groupId>cv.igrp.platform.notification</groupId>
            <artifactId>client</artifactId>
            <version>${igrp.platform.notification.client.version}</version>
        </dependency>
        <!-- Report export (Phase 4 — Unified Audit & Reports). POI streams Excel
             (SXSSFWorkbook); OpenPDF (LGPL fork of iText 4) renders PDF. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <!-- 5.4.0 fixes CVE-2025-31672 (MEDIUM, unexpected content when
                 PARSING OOXML input); .1 is the latest patch on that line.
                 This service only writes workbooks, so the advisory barely
                 reaches it — taken because the fix is free, not because the
                 exposure is real. Staying on 5.4.x rather than 5.5.x: the
                 extra minor buys no advisory, and the export path is the one
                 place a POI regression would reach users as a corrupt
                 download. ExcelReportExporterTest is the guard — it writes a
                 workbook through both the SXSSF and fallback paths and reads
                 it back. -->
            <version>5.4.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
